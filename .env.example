# AI Code Review Bot - Environment Variables
# Copy to .env and fill in real values

# -- App --
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-min-32-chars

# -- Database (PostgreSQL 16 + pgvector) --
DB_HOST=postgres
DB_PORT=5432
DB_NAME=review_bot
DB_USER=review
DB_PASSWORD=review_secret

# -- Redis --
REDIS_HOST=redis
REDIS_PORT=6379

# -- GitHub App --
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/app/private-key.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -- Guest Login (Demo Account) --
# GitHub Personal Access Token for guest login (allows visitors to explore without OAuth)
# Create a PAT at: https://github.com/settings/tokens/new (select repo scope)
GUEST_GITHUB_TOKEN=

# -- Proxy (required if server cannot reach github.com directly, e.g. China) --
# For Clash on the host machine, use host.docker.internal (mapped in docker-compose.yml):
# HTTPS_PROXY=http://host.docker.internal:7897
# HTTP_PROXY=http://host.docker.internal:7897
# NO_PROXY=localhost,127.0.0.1,postgres,redis

# -- LLM (Qwen via DashScope, OpenAI-compatible API) --
OPENAI_API_KEY=
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
OPENAI_MODEL_LIGHT=qwen-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1

# -- LLM Budget --
LLM_BUDGET_DAILY_USD=50
LLM_BUDGET_MAX_TOKENS_PER_PR=500000

# -- Sentry --
SENTRY_DSN=

# -- Monitoring --
GRAFANA_PASSWORD=admin

# -- CORS (comma-separated) --
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
